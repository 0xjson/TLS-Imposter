{
  "name": "tls-imposter",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:helper": "cd helper && GOOS=windows GOARCH=amd64 go build -trimpath -ldflags \"-s -w -H windowsgui\" -o ../packages/backend/assets/bin/tls-imposter-helper.exe ./cmd/tls-imposter-helper",
    "build": "pnpm build:helper && caido-dev build",
    "build:plugin": "caido-dev build",
    "test:helper": "cd helper && go test ./...",
    "test:backend": "pnpm -C packages/backend test",
    "test": "pnpm test:helper && pnpm test:backend",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@caido-community/dev": "0.1.7",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.6.0"
  }
}
